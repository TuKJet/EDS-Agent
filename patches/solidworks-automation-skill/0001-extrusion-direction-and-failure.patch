+++ b/tests/test_mcp_sketch_and_extrude.py
@@ -0,0 +1,161 @@
+from contextlib import contextmanager
+import json
+from pathlib import Path
+from types import SimpleNamespace
+import sys
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "mcp-server"))
+import server
+
+
+def _params(**overrides):
+    values = {
+        "shape": "circle",
+        "radius_mm": 5.0,
+        "depth_mm": 10.0,
+        "plane_name": "Front Plane",
+        "center_x_mm": 0.0,
+        "center_y_mm": 0.0,
+        "midplane": False,
+        "cut": False,
+        "direction": None,
+        "feature_name": None,
+        "response_format": "json",
+    }
+    values.update(overrides)
+    return server.SolidWorksSketchOnPlaneInput(**values)
+
+
+def test_cut_midplane_is_rejected_before_active_com_call(monkeypatch):
+    called = False
+
+    def active_part():
+        nonlocal called
+        called = True
+        raise AssertionError("active SolidWorks document must not be queried")
+
+    monkeypatch.setattr(server, "_active_part_required", active_part)
+    result = json.loads(server.solidworks_sketch_and_extrude(_params(cut=True, midplane=True)))
+    assert called is False
+    assert result["status"] == "error"
+    assert "cut and midplane" in result["message"]
+
+
+def test_one_sided_direction_and_feature_name_are_applied(monkeypatch):
+    feature = SimpleNamespace(Name="Generated")
+    calls = []
+
+    @contextmanager
+    def fake_sketch(_model, _plane):
+        yield "Sketch1"
+
+    monkeypatch.setattr(server, "_active_part_required", lambda: (object(), object()))
+    monkeypatch.setattr(server, "_run_locked", lambda operation, *_args: operation())
+    monkeypatch.setattr(server, "sketch", fake_sketch)
+    monkeypatch.setattr(server, "sketch_circle", lambda *_args: None)
+    monkeypatch.setattr(server, "extrude_boss", lambda *args, **kwargs: calls.append((args, kwargs)) or feature)
+    monkeypatch.setattr(server, "_model_summary", lambda _model: {})
+
+    result = server.solidworks_sketch_and_extrude(
+        _params(direction=False, feature_name="BaseBoss")
+    )
+
+    assert calls[0][1]["direction"] is False
+    assert feature.Name == "BaseBoss"
+    assert result["feature_name"] == "BaseBoss"
+    assert result["direction"] is False
+
+
+def test_cut_dispatches_to_cut_with_explicit_direction(monkeypatch):
+    feature = SimpleNamespace(Name="Cut-Feature")
+    calls = []
+
+    @contextmanager
+    def fake_sketch(_model, _plane):
+        yield "Sketch1"
+
+    monkeypatch.setattr(server, "_active_part_required", lambda: (object(), object()))
+    monkeypatch.setattr(server, "_run_locked", lambda operation, *_args: operation())
+    monkeypatch.setattr(server, "sketch", fake_sketch)
+    monkeypatch.setattr(server, "sketch_circle", lambda *_args: None)
+    monkeypatch.setattr(server, "extrude_cut", lambda *args, **kwargs: calls.append((args, kwargs)) or feature)
+    monkeypatch.setattr(server, "extrude_midplane", lambda *_args: pytest.fail("midplane dispatch"))
+    monkeypatch.setattr(server, "_model_summary", lambda _model: {})
+
+    result = server.solidworks_sketch_and_extrude(_params(cut=True, direction=False))
+
+    assert calls[0][1]["direction"] is False
+    assert result["operation"] == "cut"
+    assert result["feature_created"] is True
+
+
+@pytest.mark.parametrize("reject_write", [False, True])
+def test_feature_name_write_or_readback_failure_is_not_success(monkeypatch, reject_write):
+    class RejectingFeature:
+        @property
+        def Name(self):
+            return "Original"
+
+        @Name.setter
+        def Name(self, _value):
+            raise RuntimeError("name rejected")
+
+    if reject_write:
+        feature = RejectingFeature()
+    else:
+        class SilentFeature:
+            @property
+            def Name(self):
+                return "Original"
+
+            @Name.setter
+            def Name(self, _value):
+                pass
+
+        feature = SilentFeature()
+
+    @contextmanager
+    def fake_sketch(_model, _plane):
+        yield "Sketch1"
+
+    monkeypatch.setattr(server, "_active_part_required", lambda: (object(), object()))
+    monkeypatch.setattr(server, "_load_automation_modules", lambda: None)
+    monkeypatch.setattr(server, "_coinitialize", lambda: None)
+    monkeypatch.setattr(server, "sketch", fake_sketch)
+    monkeypatch.setattr(server, "sketch_circle", lambda *_args: None)
+    monkeypatch.setattr(server, "extrude_boss", lambda *_args, **_kwargs: feature)
+    monkeypatch.setattr(server, "_model_summary", lambda _model: {})
+
+    result = json.loads(server.solidworks_sketch_and_extrude(_params(feature_name="Requested")))
+
+    assert result["status"] == "error"
+    assert result["feature_created"] is True
+    assert result["requested_feature_name"] == "Requested"
+    assert result["sketch_name"] == "Sketch1"
+    assert result["operation"] == "boss"
+    assert result["retryable"] is False
+    assert result["needs_inspection"] is True
+    assert result["failure_stage"] == ("feature_name_write" if reject_write else "feature_name_readback")
+    assert "Do not retry blindly" in result["suggestion"]
+
+
+def test_omitted_direction_preserves_underlying_default(monkeypatch):
+    feature = SimpleNamespace(Name="Generated")
+    calls = []
+
+    @contextmanager
+    def fake_sketch(_model, _plane):
+        yield "Sketch1"
+
+    monkeypatch.setattr(server, "_active_part_required", lambda: (object(), object()))
+    monkeypatch.setattr(server, "_run_locked", lambda operation, *_args: operation())
+    monkeypatch.setattr(server, "sketch", fake_sketch)
+    monkeypatch.setattr(server, "sketch_circle", lambda *_args: None)
+    monkeypatch.setattr(server, "extrude_cut", lambda *args, **kwargs: calls.append((args, kwargs)) or feature)
+    monkeypatch.setattr(server, "_model_summary", lambda _model: {})
+
+    server.solidworks_sketch_and_extrude(_params(cut=True))
+
+    assert calls[0][1] == {}
