+def test_open_document_native_part_routes_through_connect_and_open(monkeypatch, tmp_path):
+    source = tmp_path / "native.sldprt"
+    app = SimpleNamespace()
+    opened = SimpleNamespace(
+        GetType=lambda: 1,
+        GetPathName=lambda: str(source),
+    )
+    connect_calls = []
+    open_calls = []
+    monkeypatch.setattr(server, "connect_solidworks", lambda **kwargs: connect_calls.append(kwargs) or (app, None), raising=False)
+    monkeypatch.setattr(server, "open_document", lambda *args, **kwargs: open_calls.append((args, kwargs)) or opened, raising=False)
+    monkeypatch.setattr(server, "get_com_member", lambda obj, name, default=None, *args: getattr(obj, name, default)() if callable(getattr(obj, name, None)) else getattr(obj, name, default), raising=False)
+    monkeypatch.setattr(server, "_bind_document_context", lambda *args, **kwargs: None, raising=False)
