+@pytest.mark.parametrize("suffix", [".step", ".stp"])
+def test_open_document_rejects_step_formats_before_connecting(monkeypatch, tmp_path, suffix):
+    connect_calls = []
+    monkeypatch.setattr(server, "connect_solidworks", lambda **kwargs: connect_calls.append(kwargs), raising=False)
+    monkeypatch.setattr(server, "_run_locked", lambda operation, *args, **kwargs: operation())
+    params = SimpleNamespace(
+        path=str(tmp_path / f"import{suffix}"),
+        read_only=False,
+        silent=True,
+        configuration=None,
+        response_format="json",
+    )
+
+    with pytest.raises(ValueError, match="only native SolidWorks formats"):
+        server.solidworks_open_document(params)
