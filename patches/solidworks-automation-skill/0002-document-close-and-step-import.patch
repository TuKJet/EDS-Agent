+def test_close_explicitly_authorizes_exact_unsaved_active_document(monkeypatch):
+    first = SimpleNamespace(
+        GetPathName=lambda: "", GetType=lambda: 1, GetTitle=lambda: "A-cut.SLDPRT"
+    )
+    app = SimpleNamespace(ActiveDoc=first, docs=[first], closed=[])
+    app.GetDocuments = lambda: list(app.docs)
+    def close_doc(title):
+        app.closed.append(title)
+        app.docs = []
+        app.ActiveDoc = None
+    app.CloseDoc = close_doc
+    monkeypatch.setattr(server, "connect_solidworks", lambda **_: (app, first), raising=False)
+    monkeypatch.setattr(server, "get_com_member", lambda obj, name, default=None, *args: getattr(obj, name, default)() if callable(getattr(obj, name, None)) else getattr(obj, name, default), raising=False)
+    monkeypatch.setattr(server, "_run_locked", lambda operation, *args, **kwargs: operation())
+    cleared = []
+    monkeypatch.setattr(server, "clear_sketch_selection_cache", lambda model=None: cleared.append(model), raising=False)
+    server._document_context = None
+    params = SimpleNamespace(
+        close_all=False, save_changes=False, expected_title="A-cut.SLDPRT",
+        expected_type=1, discard_unsaved=True, response_format="json"
+    )
+    result = server.solidworks_close_documents(params)
+    assert result == {"status": "ok", "closed": "A-cut.SLDPRT"}
+    assert app.closed == ["A-cut.SLDPRT"]
+    assert cleared == [first]
+
