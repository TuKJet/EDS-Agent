+def _curve_bounds(edge):
+    """Read the trimmed curve parameter interval without changing its sense."""
+    errors = []
+    try:
+        data = get_com_member(edge, "GetCurveParams3")
+        start = _finite_number(getattr(data, "UMinValue"))
+        end = _finite_number(getattr(data, "UMaxValue"))
+        if start is None or end is None:
+            raise ValueError("UMinValue/UMaxValue is not finite")
+        return start, end, errors
+    except Exception as exc:
+        errors.append(f"读取曲线参数范围(GetCurveParams3)失败: {exc}")
+
+    try:
+        values = list(get_com_member(edge, "GetCurveParams2") or [])
+        start = _finite_number(values[6])
+        end = _finite_number(values[7])
+        if start is None or end is None:
+            raise ValueError("GetCurveParams2()[6]/[7] is not finite")
+        return start, end, errors
+    except Exception as exc:
+        errors.append(f"读取曲线参数范围(GetCurveParams2)失败: {exc}")
+        return None, None, errors
+
