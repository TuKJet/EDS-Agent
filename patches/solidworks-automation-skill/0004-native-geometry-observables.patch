diff --git a/tests/test_mcp_edge_readback.py b/tests/test_mcp_edge_readback.py
new file mode 100644
--- /dev/null
+++ b/tests/test_mcp_edge_readback.py
@@ -0,0 +1,18 @@
+"""Expose native curve classification without treating all noncircles as lines."""
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "mcp-server"))
+import server
+
+
+def test_list_edges_preserves_true_false_and_unknown_line_classification(monkeypatch):
+    descriptors = [dict(index=i, length_mm=10.0, direction=[1.0, 0.0, 0.0],
+                        mid_point_mm=[0.0, 0.0, 0.0], is_line=value, is_circle=False)
+                   for i, value in enumerate([True, False, None])]
+    monkeypatch.setattr(server, "_active_part_required", lambda: (object(), object()))
+    monkeypatch.setattr(server, "_run_locked", lambda operation, *_args: operation())
+    monkeypatch.setattr(server, "iter_model_edges", lambda _model: (descriptors, []), raising=False)
+    monkeypatch.setattr(server, "filter_edges", lambda items, **_kwargs: (items, []), raising=False)
+    result = server.solidworks_list_edges(server.SolidWorksEdgeInspectionInput(include_convexity=False, response_format="json"))
+    assert [edge["is_line"] for edge in result["edges"]] == [True, False, None]
