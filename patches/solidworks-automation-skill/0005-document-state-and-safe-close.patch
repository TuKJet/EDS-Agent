+def _inspect_document(model) -> Dict[str, Any]:
+    """Read document identity and save state without changing the active document."""
+    result: Dict[str, Any] = {}
+    for field, member in (("title", "GetTitle"), ("path", "GetPathName"), ("type", "GetType")):
+        try:
+            result[field] = get_com_member(model, member)
+        except Exception as exc:
+            result[field] = None
+            result[f"{field}_error"] = f"读取 {member} 失败: {exc}"
+    try:
+        save_flag = get_com_member(model, "GetSaveFlag")
+        if not isinstance(save_flag, bool):
+            raise TypeError(f"GetSaveFlag 返回非 bool 值: {save_flag!r}")
+        result["needs_save"] = save_flag
+    except Exception as exc:
+        result["needs_save"] = None
+        result["needs_save_error"] = f"读取 GetSaveFlag 失败: {exc}"
+    return result
+
+
+@mcp.tool(
+    name="solidworks_inspect_documents",
+    title="Inspect Open SolidWorks Documents",
+    annotations={
+        "readOnlyHint": True,
+        "destructiveHint": False,
+        "idempotentHint": True,
+        "openWorldHint": False,
+    },
+)
+def solidworks_inspect_documents(params: SolidWorksInspectDocumentsInput = SolidWorksInspectDocumentsInput()) -> str:
+    """Inspect open documents and their save state without activating or modifying them."""
+
+    def op():
+        sw, _model = connect_solidworks(wait_seconds=1)
+        active = get_com_member(sw, "ActiveDoc")
+        try:
+            documents = list(get_com_member(sw, "GetDocuments") or [])
+        except Exception as exc:
+            return {
+                "status": "error",
+                "active_document": _inspect_document(active) if active is not None else None,
+                "documents": [],
+                "documents_error": f"读取 GetDocuments 失败: {exc}",
+            }
+        return {
+            "status": "ok",
+            "active_document": _inspect_document(active) if active is not None else None,
+            "documents": [_inspect_document(document) for document in documents],
+        }
+
+    return _run_locked(op, params.response_format)
+
+
