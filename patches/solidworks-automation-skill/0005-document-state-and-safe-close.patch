+def test_inspect_documents_is_read_only_and_reports_unknown_save_flag(monkeypatch, tmp_path):
+    source = tmp_path / "saved.sldprt"
+    active = model(source)
+    active.GetSaveFlag = lambda: True
+    unknown = model(tmp_path / "unknown.sldprt")
+    unknown.GetSaveFlag = lambda: (_ for _ in ()).throw(RuntimeError("COM unavailable"))
+    mutations = []
+    app = SimpleNamespace(ActiveDoc=active, GetDocuments=lambda: [active, unknown])
+    for name in ("CloseDoc", "CloseAllDocuments", "ActivateDoc", "Save3"):
+        setattr(app, name, lambda *args, _name=name, **kwargs: mutations.append(_name))
+    monkeypatch.setattr(server, "connect_solidworks", lambda **_: (app, active), raising=False)
+    monkeypatch.setattr(server, "get_com_member", lambda obj, name, default=None, *args: getattr(obj, name, default)() if callable(getattr(obj, name, None)) else getattr(obj, name, default), raising=False)
+    monkeypatch.setattr(server, "_run_locked", lambda operation, *args, **kwargs: operation())
+    params = server.SolidWorksInspectDocumentsInput()
+    assert "response_format" in server.SolidWorksInspectDocumentsInput.model_fields
+    assert "response_format" in server.SolidWorksInspectDocumentsInput.model_json_schema()["properties"]
+    assert params.response_format == server.ResponseFormat.JSON
+    result = server.solidworks_inspect_documents(params)
+
+    assert result["active_document"]["title"] == source.name
+    assert result["active_document"]["path"] == str(source)
+    assert result["active_document"]["type"] == 1
+    assert result["active_document"]["needs_save"] is True
+    assert result["documents"][0]["title"] == source.name
+    assert result["documents"][0]["path"] == str(source)
+    assert result["documents"][0]["type"] == 1
+    assert result["documents"][1]["needs_save"] is None
+    assert "GetSaveFlag" in result["documents"][1]["needs_save_error"]
+    assert mutations == []
