+@pytest.mark.parametrize("save_flag", [False, True])
+def test_close_saved_document_checks_save_flag(monkeypatch, tmp_path, save_flag):
+    source = tmp_path / "saved.sldprt"
+    first = model(source)
+    first.GetSaveFlag = lambda: save_flag
+    app = SimpleNamespace(ActiveDoc=first, docs=[first], close_calls=[])
+    app.GetDocuments = lambda: list(app.docs)
+    def close_doc(title):
+        app.close_calls.append(title)
+        app.docs = []
+        app.ActiveDoc = None
+    app.CloseDoc = close_doc
+    monkeypatch.setattr(server, "connect_solidworks", lambda **_: (app, first), raising=False)
+    monkeypatch.setattr(server, "get_com_member", lambda obj, name, default=None, *args: getattr(obj, name, default)() if callable(getattr(obj, name, None)) else getattr(obj, name, default), raising=False)
+    monkeypatch.setattr(server, "_run_locked", lambda operation, *args, **kwargs: operation())
+    monkeypatch.setattr(server, "clear_sketch_selection_cache", lambda model=None: None, raising=False)
+    server._document_context = {"path": str(source), "type": 1, "configuration": "Default"}
+    params = SimpleNamespace(close_all=False, save_changes=False, response_format="json")
+
+    if save_flag:
+        with pytest.raises(RuntimeError, match="未保存修改"):
+            server.solidworks_close_documents(params)
+        assert app.close_calls == []
+    else:
+        result = server.solidworks_close_documents(params)
+        assert result == {"status": "ok", "closed": "saved.sldprt"}
+        assert app.close_calls == ["saved.sldprt"]
+
